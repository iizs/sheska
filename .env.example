SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite+aiosqlite:///./sheska.db
SOURCE_STORE_PATH=./source-store
WIKI_STORE_PATH=./wiki-store
PROMPTS_PATH=./prompts

LITELLM_PROVIDER=anthropic
LITELLM_MODEL=claude-haiku-4-5-20251001
LITELLM_API_KEY=sk-ant-...
LITELLM_BASE_URL=

# Self-signup (v0.2)
SIGNUP_ENABLED=true

# Origin URLs allowed by CORS — comma-separated. Add the host you open the
# frontend from (browser's address bar), not the backend's host.
# Example for accessing from another machine on the LAN:
#   ALLOWED_ORIGINS=http://localhost:3000,http://192.168.50.106:3000
ALLOWED_ORIGINS=http://localhost:3000

# Initial admin (used by scripts/init_env.py only — not the running backend)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# v0.4 — Agentic loop safety thresholds (override if needed)
# AGENT_MAX_ITERATIONS=20
# AGENT_MAX_TOOL_CALLS=50
# AGENT_TIMEOUT_SECONDS=300
# AGENT_REPEAT_PATTERN_THRESHOLD=3

# Output token budget per LLM call. Default 8192 = Anthropic default.
# Raise if you frequently hit stop_reason=max_tokens (Job FAILED).
# Sonnet 4.5 supports up to 64000 via extended-output beta; 16384 or 32768 is
# usually safe for large wiki page rewrites without enabling beta.
LLM_MAX_OUTPUT_TOKENS=8192
